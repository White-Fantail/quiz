{
  "name": "@quizdip/kids",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle:ios": "expo export --platform ios --output-dir ../../.expo-kids-export/ios",
    "bundle:android": "expo export --platform android --output-dir ../../.expo-kids-export/android"
  },
  "dependencies": {
    "@quizdip/domain": "*",
    "@quizdip/i18n": "*",
    "@quizdip/api-client": "*",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "expo-secure-store": "~57.0.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  }
}
