generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id
  issuer                String
  subject               String
  displayName           String
  role                  String        @default("MEMBER")
  leaderboardEligible   Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  quizzes               Quiz[]
  packs                 QuizPack[]
  sessions              PlaySession[]
  reviews               Review[]
  reports               Report[]
  mediaAssets           MediaAsset[]
  featuredWeeks         WeeklyChallenge[]
  playRuns              PlayRun[]
  creatorReviewsReceived CreatorReview[] @relation("CreatorReceived")
  creatorReviewsWritten  CreatorReview[] @relation("CreatorWritten")
  @@unique([issuer, subject])
}

model Quiz {
  id                    String        @id @default(uuid())
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  currentVersion        Int           @default(1)
  publication           String        @default("DRAFT")
  safetyStatus          String        @default("PENDING")
  kidsEligible          Boolean       @default(false)
  creatorIntent         Json?
  recommendedAudience   Json?
  categories            String[]      @default([])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  revisions             QuizRevision[]
  packItems             PackQuestion[]
  weeklyQuestions       WeeklyQuestion[]
  runQuestions          PlayRunQuestion[]
  sessions              PlaySession[]
  reviews               Review[]
  reports               Report[]
  @@index([publication, updatedAt])
  @@index([authorId, updatedAt])
}

model QuizRevision {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  version               Int
  title                 String
  prompt                String
  mode                  String
  answer                Json
  clues                 Json
  scoring               Json?
  promptMediaIds        Json          @default("[]")
  createdAt             DateTime      @default(now())
  sessions              PlaySession[]
  weeklyQuestions       WeeklyQuestion[]
  runQuestions          PlayRunQuestion[]
  @@unique([quizId, version])
}

model QuizPack {
  id                    String        @id @default(uuid())
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  title                 String
  description           String        @default("")
  publication           String        @default("DRAFT")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 PackQuestion[]
}

model PackQuestion {
  packId                String
  quizId                String
  position              Int
  pack                  QuizPack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@id([packId, quizId])
  @@unique([packId, position])
}

model PlaySession {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  revisionId            String
  revision              QuizRevision  @relation(fields: [revisionId], references: [id])
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  tokenHash             String
  runId                 String?
  run                   PlayRun? @relation(fields: [runId], references: [id])
  roundIndex            Int?
  status                String        @default("ACTIVE")
  usedClues             Int           @default(1)
  wrongGuesses          Int           @default(0)
  score                 Int           @default(0)
  startedAt             DateTime      @default(now())
  expiresAt             DateTime
  finishedAt            DateTime?
  @@unique([runId, roundIndex])
  @@index([quizId, revisionId, status])
  @@index([userId, status, score])
}

model Review {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  rating                Int
  comment               String        @default("")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  @@unique([quizId, authorId])
  @@index([quizId, createdAt])
}

model Report {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  reporterId            String
  reporter              User          @relation(fields: [reporterId], references: [id])
  reason                String
  detail                String        @default("")
  status                String        @default("OPEN")
  createdAt             DateTime      @default(now())
  @@index([quizId, status])
}

model AuditLog {
  id                    String        @id @default(uuid())
  actorId               String
  action                String
  objectId              String
  detail                Json?
  createdAt             DateTime      @default(now())
  @@index([actorId, createdAt])
}

model CreatorReview {
  id         String   @id @default(uuid())
  targetId   String
  reviewerId String
  target     User     @relation("CreatorReceived", fields: [targetId], references: [id])
  reviewer   User     @relation("CreatorWritten", fields: [reviewerId], references: [id])
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([targetId, reviewerId])
  @@index([targetId, createdAt])
}

model MediaAsset {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  kind              String
  mimeType          String
  originalName      String   @default("")
  sizeBytes         Int
  sha256            String?
  status            String   @default("UPLOADING")
  moderationStatus  String   @default("PENDING")
  storageKey        String   @unique
  uploadKey         String?  @unique
  uploadExpiresAt   DateTime?
  sourceUrl         String?
  parentId          String?
  alt               String   @default("")
  transcript        String   @default("")
  attribution       String   @default("")
  license           String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  @@index([ownerId, status, createdAt])
  @@index([parentId])
}

model WeeklyChallenge {
  id          String    @id @default(uuid())
  lane        String
  weekStart   DateTime
  weekEnd     DateTime
  hostId      String
  host        User      @relation(fields: [hostId], references: [id])
  title       String
  description String    @default("")
  status      String    @default("SUBMITTED")
  verifiedHost Boolean  @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  questions   WeeklyQuestion[]
  runs        PlayRun[]
  @@unique([lane, weekStart])
  @@index([status, weekStart, weekEnd])
}

model WeeklyQuestion {
  challengeId String
  position    Int
  quizId      String
  revisionId  String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id])
  quiz        Quiz @relation(fields: [quizId], references: [id])
  revision    QuizRevision @relation(fields: [revisionId], references: [id])
  @@id([challengeId, position])
  @@unique([challengeId, quizId])
}

model PlayRun {
  id          String    @id @default(uuid())
  mode        String
  lane        String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  weeklyId    String?
  weekly      WeeklyChallenge? @relation(fields: [weeklyId], references: [id])
  tokenHash   String
  currentIndex Int      @default(0)
  score       Int       @default(0)
  solved      Int       @default(0)
  failed      Int       @default(0)
  status      String    @default("ACTIVE")
  expiresAt   DateTime
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  questions   PlayRunQuestion[]
  sessions    PlaySession[]
  @@index([userId, startedAt])
  @@index([weeklyId, status, score])
}

model PlayRunQuestion {
  runId       String
  position    Int
  quizId      String
  revisionId  String
  run         PlayRun @relation(fields: [runId], references: [id])
  quiz        Quiz @relation(fields: [quizId], references: [id])
  revision    QuizRevision @relation(fields: [revisionId], references: [id])
  @@id([runId, position])
  @@unique([runId, quizId])
}
