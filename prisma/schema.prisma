generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id
  issuer                String
  subject               String
  displayName           String
  role                  String        @default("MEMBER")
  leaderboardEligible   Boolean       @default(false)
  leaderboardOptIn      Boolean       @default(false)
  uiLocale              String        @default("en")
  contentLocale         String        @default("en")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  quizzes               Quiz[]
  packs                 QuizPack[]
  sessions              PlaySession[]
  reviews               Review[]
  reports               Report[]
  mediaAssets           MediaAsset[]
  featuredWeeks         WeeklyChallenge[]
  playRuns              PlayRun[]
  creatorReviewsReceived CreatorReview[] @relation("CreatorReceived")
  creatorReviewsWritten  CreatorReview[] @relation("CreatorWritten")
  kidProfiles           KidProfile[]
  kidDeviceSessions     KidDeviceSession[]
  kidGuardianPin        KidGuardianPin?
  kidPairTickets        KidPairTicket[]
  @@unique([issuer, subject])
}

model Quiz {
  id                    String        @id @default(uuid())
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  currentVersion        Int           @default(1)
  sourceLocale          String        @default("und")
  localizations         QuizLocalization[]
  publication           String        @default("DRAFT")
  safetyStatus          String        @default("PENDING")
  kidsEligible          Boolean       @default(false)
  creatorIntent         Json?
  recommendedAudience   Json?
  mode                  String        @default("progressive-clues")
  answerType            String        @default("other")
  topicLinks            QuizTopic[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  revisions             QuizRevision[]
  packItems             PackQuestion[]
  weeklyQuestions       WeeklyQuestion[]
  runQuestions          PlayRunQuestion[]
  sessions              PlaySession[]
  reviews               Review[]
  reports               Report[]
  @@index([publication, updatedAt])
  @@index([authorId, updatedAt])
}

model QuizRevision {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  version               Int
  localizationId        String?
  localization          QuizLocalization? @relation(fields: [localizationId], references: [id], onDelete: SetNull)
  title                 String
  prompt                String
  mode                  String
  answerType            String        @default("other")
  answer                Json
  clues                 Json
  scoring               Json?
  promptMediaIds        Json          @default("[]")
  createdAt             DateTime      @default(now())
  sessions              PlaySession[]
  weeklyQuestions       WeeklyQuestion[]
  runQuestions          PlayRunQuestion[]
  weeklyLocalized       WeeklyQuestionLocalization[]
  reviews               Review[]
  reports               Report[]
  @@index([quizId, version])
  @@unique([localizationId, version])
}

model QuizLocalization {
  id               String   @id @default(uuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  locale           String
  status           String   @default("DRAFT")
  currentVersion   Int      @default(1)
  publishedVersion Int?
  sourceRevisionId String?
  origin           String   @default("ORIGINAL")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  revisions        QuizRevision[]
  @@unique([quizId, locale])
  @@index([locale, status])
}

model Topic {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  aliases     String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quizLinks   QuizTopic[]
  localizations TopicLocalization[]
}

model TopicLocalization {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  locale    String
  name      String
  aliases   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([topicId, locale])
  @@index([locale, name])
}

model QuizTopic {
  quizId      String
  topicId     String
  position    Int
  isSpoiler   Boolean     @default(false)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic       Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([quizId, topicId])
  @@index([quizId, position])
  @@index([topicId, isSpoiler])
}

model QuizPack {
  id                    String        @id @default(uuid())
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  title                 String
  description           String        @default("")
  sourceLocale          String        @default("und")
  localizations         QuizPackLocalization[]
  publication           String        @default("DRAFT")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 PackQuestion[]
}

model QuizPackLocalization {
  id          String   @id @default(uuid())
  packId      String
  pack        QuizPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String   @default("")
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([packId, locale])
  @@index([locale, status])
}

model PackQuestion {
  packId                String
  quizId                String
  position              Int
  pack                  QuizPack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@id([packId, quizId])
  @@unique([packId, position])
}

model PlaySession {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  revisionId            String
  revision              QuizRevision  @relation(fields: [revisionId], references: [id])
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  tokenHash             String
  locale                String        @default("und")
  runId                 String?
  run                   PlayRun? @relation(fields: [runId], references: [id])
  roundIndex            Int?
  status                String        @default("ACTIVE")
  usedClues             Int           @default(1)
  wrongGuesses          Int           @default(0)
  score                 Int           @default(0)
  startedAt             DateTime      @default(now())
  expiresAt             DateTime
  finishedAt            DateTime?
  kidSingle   KidPlaySingle?
  @@unique([runId, roundIndex])
  @@index([quizId, revisionId, status])
  @@index([userId, status, score])
}

model Review {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  rating                Int
  locale                String        @default("und")
  kind                  String        @default("QUIZ")
  revisionId            String?
  revision              QuizRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  comment               String        @default("")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  @@unique([quizId, authorId, locale, kind])
  @@index([quizId, locale, kind, rating])
  @@index([quizId, createdAt])
}

model Report {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  reporterId            String
  reporter              User          @relation(fields: [reporterId], references: [id])
  locale                String        @default("und")
  revisionId            String?
  revision              QuizRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  reason                String
  detail                String        @default("")
  status                String        @default("OPEN")
  createdAt             DateTime      @default(now())
  @@index([quizId, status])
  @@index([quizId, locale, reason])
}

model AuditLog {
  id                    String        @id @default(uuid())
  actorId               String
  action                String
  objectId              String
  detail                Json?
  createdAt             DateTime      @default(now())
  @@index([actorId, createdAt])
}

model CreatorReview {
  id         String   @id @default(uuid())
  targetId   String
  reviewerId String
  target     User     @relation("CreatorReceived", fields: [targetId], references: [id])
  reviewer   User     @relation("CreatorWritten", fields: [reviewerId], references: [id])
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([targetId, reviewerId])
  @@index([targetId, createdAt])
}

model MediaAsset {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  kind              String
  mimeType          String
  originalName      String   @default("")
  sizeBytes         Int
  sha256            String?
  status            String   @default("UPLOADING")
  moderationStatus  String   @default("PENDING")
  storageKey        String   @unique
  uploadKey         String?  @unique
  uploadExpiresAt   DateTime?
  sourceUrl         String?
  parentId          String?
  alt               String   @default("")
  transcript        String   @default("")
  attribution       String   @default("")
  license           String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  @@index([ownerId, status, createdAt])
  @@index([parentId])
}

model WeeklyChallenge {
  id          String    @id @default(uuid())
  lane        String
  weekStart   DateTime
  weekEnd     DateTime
  hostId      String
  host        User      @relation(fields: [hostId], references: [id])
  title       String
  description String    @default("")
  status      String    @default("SUBMITTED")
  verifiedHost Boolean  @default(false)
  hostDisplayName String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  questions   WeeklyQuestion[]
  localizedQuestions WeeklyQuestionLocalization[]
  runs        PlayRun[]
  @@index([lane, weekStart])
  @@index([status, weekStart, weekEnd])
}

model WeeklyQuestion {
  challengeId String
  position    Int
  quizId      String
  revisionId  String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id])
  quiz        Quiz @relation(fields: [quizId], references: [id])
  revision    QuizRevision @relation(fields: [revisionId], references: [id])
  @@id([challengeId, position])
  @@unique([challengeId, quizId])
}

model WeeklyQuestionLocalization {
  challengeId String
  position    Int
  locale      String
  revisionId  String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  revision    QuizRevision @relation(fields: [revisionId], references: [id])
  @@id([challengeId, position, locale])
  @@index([revisionId])
}

model PlayRun {
  id          String    @id @default(uuid())
  mode        String
  lane        String
  locale      String    @default("und")
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  weeklyId    String?
  weekly      WeeklyChallenge? @relation(fields: [weeklyId], references: [id])
  officialEligible Boolean @default(false)
  tokenHash   String
  currentIndex Int      @default(0)
  score       Int       @default(0)
  solved      Int       @default(0)
  failed      Int       @default(0)
  status      String    @default("ACTIVE")
  expiresAt   DateTime
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  questions   PlayRunQuestion[]
  sessions    PlaySession[]
  kidOwnership KidPlayRun?
  @@index([userId, startedAt])
  @@index([weeklyId, status, score])
}

model PlayRunQuestion {
  runId       String
  position    Int
  quizId      String
  revisionId  String
  run         PlayRun @relation(fields: [runId], references: [id])
  quiz        Quiz @relation(fields: [quizId], references: [id])
  revision    QuizRevision @relation(fields: [revisionId], references: [id])
  @@id([runId, position])
  @@index([runId, quizId])
}

/** Child profiles are owned by verified guardian QuizDip accounts, never public users. */
model KidProfile {
  id              String   @id @default(uuid())
  guardianId      String
  guardian        User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  nickname        String
  ageBand         String   @default("MIDDLE")
  locale          String   @default("en")
  sessionMinutes  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  devices         KidDeviceSession[]
  playRuns        KidPlayRun[]
  singlePlays     KidPlaySingle[]
  pairTickets     KidPairTicket[]
  @@index([guardianId, updatedAt])
}

model KidGuardianPin {
  guardianId       String   @id
  guardian         User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  hash             String
  attempts         Int      @default(0)
  lockedUntil      DateTime?
  updatedAt        DateTime @updatedAt
}

model KidDeviceSession {
  id           String   @id @default(uuid())
  guardianId   String
  guardian     User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  profileId    String
  profile      KidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  clientKind   String   @default("WEB")
  deviceName   String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  @@index([guardianId, revokedAt])
  @@index([profileId, revokedAt, expiresAt])
}

/** Guardian-authorized, one-time, short-lived native-device pairing tickets. Codes are never stored in plaintext. */
model KidPairTicket {
  id         String    @id @default(uuid())
  guardianId String
  guardian   User      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  profileId  String
  profile    KidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  @@index([guardianId, expiresAt, consumedAt])
}

/** Private, nonpublic child ownership of existing server-graded play runs. */
model KidPlayRun {
  runId     String  @id
  run       PlayRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  profileId String
  profile   KidProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  deviceId  String
  createdAt DateTime @default(now())
  @@index([profileId,createdAt])
  @@index([profileId,deviceId])
}

/** Standalone Discover quiz sessions are also linked to the child, never an adult User. */
model KidPlaySingle {
  sessionId String @id
  session   PlaySession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  profileId String
  profile   KidProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  deviceId  String
  createdAt DateTime @default(now())
  @@index([profileId,createdAt])
}
