# Shared service database. Never share preview and production values.
DATABASE_URL=postgresql://user:password@localhost:5432/quizdip
DIRECT_URL=

# Better Auth root origin. Must be the exact public origin (no /api/auth suffix).
BETTER_AUTH_URL=http://localhost:3000
# Generate separately for each environment: openssl rand -base64 48
BETTER_AUTH_SECRET=
PUBLIC_ORIGIN=http://localhost:3000

# Google Cloud Console: web client credentials, callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer: Services ID and Sign in with Apple client secret JWT
# Redirect: https://<your-domain>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Recommended: dynamic Apple JWT signing with your Team ID, Key ID and .p8 private key
# (alternative to a static APPLE_CLIENT_SECRET JWT, which expires).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Prefer MCP CIMD; only enable public DCR when controlled and rate limited.
MCP_ENABLE_DCR=false

# Cloudflare R2 (S3-compatible) private bucket; never expose these to client
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quizdip-media-dev

# Exact, comma-separated approved HTTPS hostnames for server-side importing. Empty = disabled.
MEDIA_IMPORT_HOSTS=

# Server-only key for signed-in multi-round game resume across devices
# Generate independently per environment: openssl rand -base64 48
PLAY_RUN_SECRET=
